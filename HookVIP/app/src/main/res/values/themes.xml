<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 参考 Rain_1.1.4：Material 3 + 日夜跟随 + 无 ActionBar -->
    <style name="Base.Theme.HookVIP" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">?attr/isLightTheme</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.HookVIP" parent="Base.Theme.HookVIP" />

    <style name="Widget.HookVip.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
